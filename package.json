{
  "name": "janja-monorepo",
  "private": true,
  "workspaces": [
    "server",
    "web",
    "desktop"
  ],
  "scripts": {
    "dev:livekit": "docker compose -f docker-compose.dev.yml up",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "dev:desktop": "npm run dev -w desktop",
    "dist:desktop": "npm run dist -w desktop",
    "test": "npm test -w server && npm test -w web",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "test:e2e": "node e2e/rodar.mjs",
    "medir:blobs": "node scripts/medir-blobs.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
