# Copie para deploy/.env e preencha. Os dois domínios precisam apontar (registro DNS A) para o IP da VPS.
API_DOMAIN=api.syden.chat
LIVEKIT_DOMAIN=live.syden.chat

# Endereço do site no GitHub Pages (só a origem, sem o /repo no final)
CORS_ORIGIN=https://syden.chat

# Gere com: openssl rand -hex 32
JWT_SECRET=
# Código que os amigos usam para criar conta; também é o convite da primeira comunidade.
# OBRIGATÓRIO enquanto o cadastro for fechado: com ele vazio, o servidor se recusa a subir, para o Syden
# não abrir para a internet sem
# ninguém perceber. Se a intenção for mesmo deixar qualquer pessoa criar conta, escreva CADASTRO_ABERTO=sim.
INVITE_CODE=

# Cadastro aberto: qualquer pessoa cria conta, sem código nenhum.
#
# ATENÇÃO, porque são DOIS PORTÕES DIFERENTES: ter CONTA passa a ser livre, mas entrar numa COMUNIDADE
# continua exigindo convite de quem já está lá. Quem chega sem convite fica sem comunidade nenhuma e cria
# a sua — ninguém cai na comunidade dos outros por acidente.
#
# O que muda de verdade é o seu trabalho: entra gente que você não conhece, e alguém precisa ler a aba
# Denúncias. Abrir é fácil e reversível; tirar do ar contas de estranhos depois é bem mais chato.
# CADASTRO_ABERTO=sim

# Historico de disponibilidade no painel de saude, medido de fora pelo UptimeRobot (gratis). Chave so de
# leitura, criada em uptimerobot.com -> My Settings -> API. Sem ela, a secao nao aparece.
# Lembre do que isto NAO e: se o servidor cair, o painel nao abre. O aviso de queda continua sendo o
# e-mail que o UptimeRobot manda; aqui fica a memoria de quanto o Syden ficou no ar.
# UPTIMEROBOT_API_KEY=

# Audiencia do site no painel de saude, medida pelo Web Analytics da Cloudflare. Traz quantas visitas a
# pagina recebeu e quanto ela demorou para abrir PARA QUEM ESTAVA ABRINDO — numero que nenhum teste da
# nossa maquina produz, porque aqui a rede e sempre boa.
#
# O token e SO DE LEITURA e com UMA permissao: Account -> Account Analytics -> Read. Nada alem disso; um
# token com mais poder, se vazar, deixa mexer na configuracao da Cloudflare, e o painel so precisa ler.
# Criado em: dash.cloudflare.com -> perfil -> API Tokens -> Create Custom Token.
#
# Os outros dois valores saem de `node server/scripts/audiencia.mjs`, que lista as contas e os sites.
# Sem as tres linhas, a secao simplesmente nao aparece no painel — como a do UptimeRobot.
#
# Ligar isto exige que a medicao esteja DECLARADA na politica de privacidade (secao "Medicao do site").
# Se um dia ela for desligada no painel da Cloudflare, o texto de la sai junto.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_SITE_TAG=

# Turnstile da Cloudflare: a UNICA defesa que funciona contra enxame de robos vindo de muitos enderecos
# diferentes (os freios por IP nao veem nada de errado nesse caso). Grátis, e quase sempre invisivel para
# quem e gente. As duas chaves saem de: painel da Cloudflare -> Turnstile -> Add widget.
# Sem elas, fica desligado e o cadastro funciona como sempre.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Quantas contas podem ser criadas por dia do mesmo endereco. Amigos atras do mesmo Wi-Fi somam entre si.
# FREIO_CADASTROS_POR_DIA=10

# Teto de arquivos por pessoa, em MB. Limita o estrago que UMA conta faz no disco; contra enxame quem
# protege e o Turnstile. Recado em video conta aqui, mas vence sozinho e devolve o espaco.
# COTA_POR_PESSOA_MB=300

# Freios contra tentativa de adivinhar senha. Os padrões servem para um grupo pequeno; aumente o primeiro
# se muita gente sair pelo mesmo IP (empresa, faculdade) e começar a aparecer "muitas tentativas seguidas".
# FREIO_TENTATIVAS_POR_ENDERECO=20
# FREIO_ERROS_POR_CONTA=10

# Gere a chave com: openssl rand -hex 8   e o segredo com: openssl rand -hex 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Franquia mensal de tráfego de saída do plano, em GB, mostrada no painel de uso (coluna "Traffic" na Hetzner).
TRAFFIC_ALLOWANCE_GB=10000

# Freios das comunidades: o servidor aguenta um tanto de gente ao mesmo tempo, não um tanto de comunidades.
MAX_COMMUNITIES_PER_USER=3
MAX_MEMBERS_PER_COMMUNITY=100

# Opcional: mostra os gráficos do painel da Hetzner dentro do Syden. Token com permissão de LEITURA,
# criado em Security → API tokens, e o número do servidor (aparece na URL do painel, depois de /servers/).
HETZNER_TOKEN=
HETZNER_SERVER_ID=

# Envio de e-mail (confirmar endereço e recuperar senha). SEM ISTO O SYDEN FUNCIONA IGUAL: as mensagens
# vão para o registro do servidor em vez de saírem. Crie a chave em resend.com → API Keys.
RESEND_API_KEY=
# Enquanto não houver domínio próprio, deixe o remetente de teste do Resend: ele só entrega para o
# e-mail dono da conta Resend, o que serve para você conferir como a mensagem chega.
# O domínio syden.chat já está verificado no Resend, então o remetente é o nosso mesmo.
EMAIL_FROM=Syden <nao-responda@syden.chat>
# ONDE O SYDEN MORA (sem a barra no fim). Daqui saem os links dos e-mails de confirmação e de
# recuperação, e para cá volta quem entra com Google, Discord, GitHub ou Steam.
#
# PRECISA INCLUIR O /app. O Syden saiu da raiz de syden.chat — que hoje é a página de apresentação — e
# foi para /app/. Apontando para a raiz, tudo o que depende desta variável cai na apresentação, que é
# uma página estática e não faz nada com o código que chegou: o link do e-mail "abre o site" e não
# confirma nada, e entrar com Google devolve a pessoa a um lugar que não conclui a entrada. Nenhum dos
# dois dá erro na tela, e foi assim que isso passou despercebido até 28/09/2026.
SITE_URL=https://syden.chat/app

# O cadastro exige confirmar o e-mail antes de entrar?
#
# DEIXE EM BRANCO. Em branco, ele SEGUE O ENVIO: com RESEND_API_KEY preenchida, exige; sem ela, não.
# Isso é trava de segurança, não conveniência — se ficasse sempre ligado, um dia sem chave do Resend
# viraria um Syden onde ninguém mais consegue se cadastrar, porque a conta nasceria trancada e o link
# para destrancá-la nunca sairia. E ninguém veria erro: as pessoas simplesmente sumiriam na porta.
#
# Só preencha (sim/nao) para forçar, sabendo o que está fazendo.
EXIGIR_CONFIRMACAO_EMAIL=

# ---------------------------------------------------------------------------------------------------
# Entrar com Google, Discord, GitHub ou Steam
# ---------------------------------------------------------------------------------------------------
# SEM AS CHAVES, O SYDEN FUNCIONA IGUAL: o botão simplesmente não aparece na tela de entrada, e a rota
# responde "não existe". Cada provedor é independente — dá para ligar só o Google, por exemplo.
#
# O endereço PÚBLICO desta API. Os provedores devolvem o navegador para cá, e tem que bater LETRA POR
# LETRA com o que for cadastrado lá. Não dá para adivinhar a partir do pedido: atrás do Caddy ele chega
# como "localhost:3001".
API_URL=https://api.syden.chat

# --- Google -----------------------------------------------------------------------------------------
# console.cloud.google.com -> APIs e Serviços -> Credenciais -> Criar credenciais -> ID do cliente OAuth
# -> Aplicativo da Web. Em "URIs de redirecionamento autorizados", ponha EXATAMENTE:
#   https://api.syden.chat/api/auth/social/google/volta
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Discord ----------------------------------------------------------------------------------------
# discord.com/developers/applications -> New Application -> OAuth2. Em "Redirects", ponha:
#   https://api.syden.chat/api/auth/social/discord/volta
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- GitHub -----------------------------------------------------------------------------------------
# github.com/settings/developers -> OAuth Apps -> New OAuth App.
#   Homepage URL:               https://syden.chat
#   Authorization callback URL: https://api.syden.chat/api/auth/social/github/volta
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Steam ------------------------------------------------------------------------------------------
# A Steam É DIFERENTE DAS OUTRAS TRÊS: ela não usa OAuth, e por isso não tem "cliente" nem "segredo".
# Não se cadastra endereço de volta em lugar nenhum, e não existe painel de aplicativo para criar.
#
# Esta chave serve SÓ para buscar o nome de quem entrou; sem ela a pessoa nasceria chamada "jogador".
# Sai na hora, de graça, em steamcommunity.com/dev/apikey (no campo de domínio ponha syden.chat).
#
# ATENÇÃO, e vale avisar quem usar: A STEAM NÃO INFORMA E-MAIL. Quem entrar só por ela não consegue
# recuperar a senha por e-mail enquanto não cadastrar um endereço nas configurações — o app já avisa
# isso embaixo do botão.
STEAM_API_KEY=
