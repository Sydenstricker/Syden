# Copie para deploy/.env e preencha. Os dois domínios precisam apontar (registro DNS A) para o IP da VPS.
API_DOMAIN=api.syden.chat
LIVEKIT_DOMAIN=live.syden.chat

# Endereço do site no GitHub Pages (só a origem, sem o /repo no final)
CORS_ORIGIN=https://seuusuario.github.io

# Gere com: openssl rand -hex 32
JWT_SECRET=
# Código que os amigos usam para criar conta; também é o convite da primeira comunidade.
# OBRIGATÓRIO: com ele vazio, o servidor se recusa a subir, para o Syden não abrir para a internet sem
# ninguém perceber. Se a intenção for mesmo deixar qualquer pessoa criar conta, escreva CADASTRO_ABERTO=sim.
INVITE_CODE=

# Freios contra tentativa de adivinhar senha. Os padrões servem para um grupo pequeno; aumente o primeiro
# se muita gente sair pelo mesmo IP (empresa, faculdade) e começar a aparecer "muitas tentativas seguidas".
# FREIO_TENTATIVAS_POR_ENDERECO=20
# FREIO_ERROS_POR_CONTA=10

# Gere a chave com: openssl rand -hex 8   e o segredo com: openssl rand -hex 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Franquia mensal de tráfego de saída do plano, em GB, mostrada no painel de uso (coluna "Traffic" na Hetzner).
TRAFFIC_ALLOWANCE_GB=10000

# Freios das comunidades: o servidor aguenta um tanto de gente ao mesmo tempo, não um tanto de comunidades.
MAX_COMMUNITIES_PER_USER=3
MAX_MEMBERS_PER_COMMUNITY=100

# Opcional: mostra os gráficos do painel da Hetzner dentro do Syden. Token com permissão de LEITURA,
# criado em Security → API tokens, e o número do servidor (aparece na URL do painel, depois de /servers/).
HETZNER_TOKEN=
HETZNER_SERVER_ID=

# Envio de e-mail (confirmar endereço e recuperar senha). SEM ISTO O SYDEN FUNCIONA IGUAL: as mensagens
# vão para o registro do servidor em vez de saírem. Crie a chave em resend.com → API Keys.
RESEND_API_KEY=
# Enquanto não houver domínio próprio, deixe o remetente de teste do Resend: ele só entrega para o
# e-mail dono da conta Resend, o que serve para você conferir como a mensagem chega.
# O domínio syden.chat já está verificado no Resend, então o remetente é o nosso mesmo.
EMAIL_FROM=Syden <nao-responda@syden.chat>
# Endereço do site, usado para montar os links que vão dentro do e-mail (sem a barra no fim).
SITE_URL=https://seuusuario.github.io/Janja
