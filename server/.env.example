PORT=3001
# Segredo que assina os tokens de login. Em produção, use um valor aleatório longo (ex.: openssl rand -hex 32).
JWT_SECRET=troque-isto-por-um-segredo-longo
# Código que os amigos precisam informar para criar conta. Deixe vazio para cadastro livre.
INVITE_CODE=amigos
# Origens autorizadas a chamar a API, separadas por vírgula. Ex.: https://seuusuario.github.io
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=./janja.db

# LiveKit (estes valores batem com o `livekit-server --dev` local)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
